rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own history.
    match /history/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // A user can create only an audit event tied to their own UID. Reading
    // requires a server-issued custom claim; a client-side email list is not
    // an authorization boundary.
    match /audit/{docId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /users/{uid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /corrections/{docId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      allow update: if request.auth != null && request.auth.token.admin == true;
    }

    // Aggregate only: no question text, transcript, UID or case identifier is
    // stored. Signed-in users may export these anonymous counts.
    match /unanswered/{fingerprint} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['hash', 'language', 'count', 'createdAt', 'updatedAt'])
        && request.resource.data.hash == fingerprint
        && request.resource.data.count == 1;
      allow update: if request.auth != null
        && request.resource.data.hash == resource.data.hash
        && request.resource.data.language == resource.data.language
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']);
      allow delete: if false;
    }

    // The public-information corpus is written only by the server-side import
    // pipeline. The voice API reads it with Firebase Admin credentials; client
    // applications cannot inject or alter answer sources.
    match /opportunities/{docId} {
      allow read, write: if false;
    }
    match /opportunity_versions/{docId} {
      allow read, write: if false;
    }
    match /general_context/{docId} {
      allow read, write: if false;
    }
    match /opportunity_chunks/{docId} {
      allow read, write: if false;
    }
    match /sources/{docId} {
      allow read, write: if false;
    }
    match /ingestion_sources/{docId} {
      allow read, write: if false;
    }
    match /ingestion_runs/{docId} {
      allow read, write: if false;
    }
  }
}
