# Google Cloud Text-to-Speech API key, used by api/speak.js. Create it in
# Google Cloud Console (see README > Setup > Google Cloud Text-to-Speech)
# and restrict it to the Cloud Text-to-Speech API only.
GOOGLE_TTS_API_KEY=REPLACE_ME

# Server-side only. Never commit a real key or reference it from client
# code. Used by every api/*.js handler except speak.js: transcription
# (api/transcribe.js), reasoning and drafts (api/answer.js, api/artifact.js),
# lightweight tasks (lib/translate.js) and moderation (api/guard-input.js,
# api/answer.js's output gate). See config/ai.js for which model each task
# uses and docs/PROVIDER-HISTORY.md for what this replaced.
OPENAI_API_KEY=REPLACE_ME

# open (default): a moderation-call failure serves the answer anyway, logs
# it, and sets moderation_skipped on the response, so a transient OpenAI
# outage does not take the app down mid-demo. closed: a moderation-call
# failure blocks the response with a 503 instead.
MODERATION_FAIL_MODE=open

# Required in production for Firebase ID-token verification and the shared
# Firestore per-user rate limiter. Use one-line JSON; never expose it to the
# browser or commit the real value.
FIREBASE_PROJECT_ID=bestpossiblevoice
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"bestpossiblevoice","private_key":"REPLACE_ME","client_email":"REPLACE_ME"}

# Use "local" until the dry-run and authenticated Firestore import are checked.
# Set to "firestore" only in the server environment after importing published data.
OPPORTUNITY_SOURCE=local

API_RATE_LIMIT_PER_MINUTE=30
PROVIDER_TIMEOUT_MS=15000
